{
  "info": {
    "name": "recall-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for recall-service APIs.\n\nService: http://localhost:8091"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8091"
    },
    {
      "key": "tenantId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "userId",
      "value": "22222222-2222-2222-2222-222222222222"
    },
    {
      "key": "topicId",
      "value": "33333333-3333-3333-3333-333333333333"
    },
    {
      "key": "notificationId",
      "value": "44444444-4444-4444-4444-444444444444"
    }
  ],
  "item": [
    {
      "name": "Recall",
      "item": [
        {
          "name": "Record Recall Attempt",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topicId\": \"{{topicId}}\",\n  \"option\": \"CORRECT\",\n  \"timeSpentSeconds\": 45\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/recall/attempts"
          }
        },
        {
          "name": "Get Recall Schedule",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/recall/schedule/{{topicId}}"
          }
        },
        {
          "name": "Get Due Recall Items",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/recall/due?limit=50"
          }
        },
        {
          "name": "Reset Recall Schedule",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/recall/schedule/{{topicId}}/reset"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Create Notifications",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userIds\": [\"{{userId}}\"],\n  \"type\": \"RECALL_DUE\",\n  \"title\": \"Time to review!\",\n  \"message\": \"You have topics due for review.\",\n  \"referenceId\": \"{{topicId}}\",\n  \"referenceType\": \"TOPIC\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/v1/notifications"
          }
        },
        {
          "name": "Get Notifications (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/v1/notifications?page=0&size=20"
          }
        },
        {
          "name": "Get Unread Notifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/v1/notifications/unread"
          }
        },
        {
          "name": "Get Unread Count",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/v1/notifications/unread/count"
          }
        },
        {
          "name": "Mark Notification as Read",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/v1/notifications/{{notificationId}}/read"
          }
        },
        {
          "name": "Mark All as Read",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/v1/notifications/read-all"
          }
        }
      ]
    }
  ]
}
