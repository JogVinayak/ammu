              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectedBy\": \"{{userId}}\",\n  \"rejectionReason\": \"Needs more detail\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/notes/{{noteId}}/reject"
          }
        },
        {
          "name": "Mark Ready",
          "request": {
