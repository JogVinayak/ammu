          }
        },
        {
          "name": "Complete Attempt",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/notes/{{noteId}}/deck/exam-attempts/{{attemptId}}/complete"
          }
        },
        {
          "name": "Abandon Attempt",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/notes/{{noteId}}/deck/exam-attempts/{{attemptId}}/abandon"
          }
        },
        {
          "name": "Submit Complete Exam",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"answers\": [\n    {\n      \"mcqId\": \"{{mcqId}}\",\n      \"selectedOptionIndex\": 0\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/notes/{{noteId}}/deck/exam-attempts/submit"
          }
        },
        {
          "name": "Get Attempt",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/notes/{{noteId}}/deck/exam-attempts/{{attemptId}}"
          }
        },
        {
          "name": "List Attempts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/notes/{{noteId}}/deck/exam-attempts?studentId={{studentId}}"
          }
        },
        {
          "name": "Get Attempt Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/notes/{{noteId}}/deck/exam-attempts/summary?studentId={{studentId}}"
          }
        }
      ]
    }
  ]
}
