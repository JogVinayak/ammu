{
  "info": {
    "name": "notes-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for notes-service APIs.\n\nService: http://localhost:8088"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088"
    },
    {
      "key": "tenantId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "userId",
      "value": "22222222-2222-2222-2222-222222222222"
    },
    {
      "key": "noteId",
      "value": "33333333-3333-3333-3333-333333333333"
    },
    {
      "key": "versionId",
      "value": "44444444-4444-4444-4444-444444444444"
    },
    {
      "key": "mcqId",
      "value": "55555555-5555-5555-5555-555555555555"
    },
    {
      "key": "flashcardId",
      "value": "66666666-6666-6666-6666-666666666666"
    },
    {
      "key": "attemptId",
      "value": "77777777-7777-7777-7777-777777777777"
    },
    {
      "key": "studentId",
      "value": "22222222-2222-2222-2222-222222222222"
    }
  ],
  "item": [
    {
      "name": "Notes",
      "item": [
        {
          "name": "Create Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"title\": \"Kinematics Basics\",\n  \"summary\": \"Intro note for motion\",\n  \"contentMd\": \"# Motion\\n\\n$ v = u + at $\",\n  \"changeSummary\": \"Initial draft\",\n  \"tags\": [\"physics\", \"motion\"],\n  \"scopeType\": \"TENANT\",\n  \"createdBy\": \"{{userId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/notes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json && json.id) {",
                  "    pm.collectionVariables.set(\"noteId\", json.id);",
                  "  }",
                  "  if (json && json.latestVersionId) {",
                  "    pm.collectionVariables.set(\"versionId\", json.latestVersionId);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Note",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/notes/{{noteId}}"
          }
        },
        {
          "name": "List Notes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/notes?tag=physics&createdBy={{userId}}&status=DRAFT&scopeType=TENANT&q=motion&page=0&size=20"
          }
        },
        {
          "name": "Update Note",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Kinematics Basics - Updated\",\n  \"summary\": \"Updated intro note\",\n  \"tags\": [\"physics\", \"basics\"],\n  \"scopeType\": \"TENANT\",\n  \"status\": \"DRAFT\",\n  \"updatedBy\": \"{{userId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/notes/{{noteId}}"
          }
        },
        {
          "name": "Create Version",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentMd\": \"# Motion\\n\\nUpdated content with examples\",\n  \"changeSummary\": \"Added examples\",\n  \"createdBy\": \"{{userId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/notes/{{noteId}}/versions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json && json.id) {",
                  "    pm.collectionVariables.set(\"versionId\", json.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Versions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/notes/{{noteId}}/versions"
          }
        },
        {
          "name": "Get Version",
          "request": {
            "method": "GET",
