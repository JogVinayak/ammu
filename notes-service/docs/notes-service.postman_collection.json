              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"versionId\": \"{{versionId}}\",\n  \"releasedBy\": \"{{userId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/notes/{{noteId}}/release"
          }
        },
        {
          "name": "Archive Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"archivedBy\": \"{{userId}}\",\n  \"archiveReason\": \"Superseded by new content\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/notes/{{noteId}}/archive"
          }
        },
        {
          "name": "Render Note",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/notes/{{noteId}}/render"
          }
        },
        {
          "name": "Access Check",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/notes/{{noteId}}/access?userId={{userId}}"
          }
        },
        {
          "name": "Delete Note",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/notes/{{noteId}}"
          }
        }
      ]
    },
    {
      "name": "MCQs",
      "item": [
        {
          "name": "Create MCQ",
