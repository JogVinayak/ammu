            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mcqs\": [\n    {\n      \"questionText\": \"What is velocity?\",\n      \"optionsJson\": \"[{\\\"index\\\":0,\\\"text\\\":\\\"Rate of change of displacement\\\",\\\"correct\\\":true},{\\\"index\\\":1,\\\"text\\\":\\\"Rate of change of distance\\\",\\\"correct\\\":false}]\",\n      \"difficulty\": \"EASY\",\n      \"explanation\": \"Velocity is displacement per unit time\",\n      \"position\": 1\n    },\n    {\n      \"questionText\": \"What is acceleration?\",\n      \"optionsJson\": \"[{\\\"index\\\":0,\\\"text\\\":\\\"Rate of change of velocity\\\",\\\"correct\\\":true},{\\\"index\\\":1,\\\"text\\\":\\\"Rate of change of speed\\\",\\\"correct\\\":false}]\",\n      \"difficulty\": \"MEDIUM\",\n      \"explanation\": \"Acceleration is velocity change per unit time\",\n      \"position\": 2\n    }\n  ],\n  \"createdBy\": \"{{userId}}\",\n  \"replaceAll\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/notes/{{noteId}}/mcqs/batch"
          }
        },
        {
          "name": "Delete MCQ",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/notes/{{noteId}}/mcqs/{{mcqId}}"
          }
        }
