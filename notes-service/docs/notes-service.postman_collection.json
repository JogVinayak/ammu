              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionText\": \"What is the SI unit of force?\",\n  \"optionsJson\": \"[{\\\"index\\\":0,\\\"text\\\":\\\"Newton\\\",\\\"correct\\\":true},{\\\"index\\\":1,\\\"text\\\":\\\"Joule\\\",\\\"correct\\\":false},{\\\"index\\\":2,\\\"text\\\":\\\"Watt\\\",\\\"correct\\\":false},{\\\"index\\\":3,\\\"text\\\":\\\"Pascal\\\",\\\"correct\\\":false}]\",\n  \"difficulty\": \"EASY\",\n  \"explanation\": \"Newton is the SI unit of force (F = ma)\",\n  \"position\": 1,\n  \"createdBy\": \"{{userId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/notes/{{noteId}}/mcqs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json && json.id) {",
                  "    pm.collectionVariables.set(\"mcqId\", json.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List MCQs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
