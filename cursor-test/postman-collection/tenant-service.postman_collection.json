{
  "info": {
    "name": "tenant-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for tenant-service APIs"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tenantId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "domainId",
      "value": "22222222-2222-2222-2222-222222222222"
    },
    {
      "key": "tenantKey",
      "value": "demo-school"
    },
    {
      "key": "hostname",
      "value": "demo.school.example"
    },
    {
      "key": "userId",
      "value": "admin-user"
    }
  ],
  "item": [
    {
      "name": "Tenants",
      "item": [
        {
          "name": "Create Tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantKey\": \"demo-school\",\n  \"name\": \"Demo School\",\n  \"policy\": {\n    \"allowSelfSignup\": false,\n    \"requireAdminApproval\": true,\n    \"allowedAuthMethods\": [\"PASSWORD\", \"OTP_SMS\"],\n    \"allowedSignupDomains\": \"example.com,school.edu\",\n    \"sessionMaxDays\": 30,\n    \"quietHoursStart\": \"22:00\",\n    \"quietHoursEnd\": \"06:00\",\n    \"extra\": {\n      \"notes\": \"Initial policy\"\n    }\n  },\n  \"branding\": {\n    \"displayName\": \"Demo School\",\n    \"logoUrl\": \"https://example.com/logo.png\",\n    \"primaryColor\": \"#0D3B66\",\n    \"accentColor\": \"#F4D35E\"\n  }\n}"
            }
          }
        },
        {
          "name": "List Tenants",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/tenants",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants"]
            }
          }
        },
        {
          "name": "Get Tenant",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}"]
            }
          }
        },
        {
          "name": "Update Tenant",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated School\",\n  \"status\": \"ACTIVE\"\n}"
            }
          }
        },
        {
          "name": "Suspend Tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}/suspend",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}", "suspend"]
            }
          }
        },
        {
          "name": "Activate Tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}/activate",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}", "activate"]
            }
          }
        },
        {
          "name": "Delete Tenant",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Policy",
      "item": [
        {
          "name": "Get Policy",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}/policy",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}", "policy"]
            }
          }
        },
        {
          "name": "Update Policy",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}/policy",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}", "policy"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"allowSelfSignup\": true,\n  \"requireAdminApproval\": true,\n  \"allowedAuthMethods\": [\"PASSWORD\", \"OTP_SMS\"],\n  \"allowedSignupDomains\": \"example.com,school.edu\",\n  \"sessionMaxDays\": 30,\n  \"quietHoursStart\": \"22:00\",\n  \"quietHoursEnd\": \"06:00\",\n  \"extra\": {\n    \"notes\": \"Updated policy\"\n  }\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Branding",
      "item": [
        {
          "name": "Get Branding",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}/branding",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}", "branding"]
            }
          }
        },
        {
          "name": "Update Branding",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}/branding",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}", "branding"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Demo School\",\n  \"logoUrl\": \"https://example.com/logo.png\",\n  \"primaryColor\": \"#0D3B66\",\n  \"accentColor\": \"#F4D35E\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Domains",
      "item": [
        {
          "name": "Add Domain",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}/domains",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}", "domains"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hostname\": \"demo.school.example\",\n  \"type\": \"CUSTOM_DOMAIN\"\n}"
            }
          }
        },
        {
          "name": "List Domains",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}/domains",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}", "domains"]
            }
          }
        },
        {
          "name": "Verify Domain",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}/domains/{{domainId}}/verify",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}", "domains", "{{domainId}}", "verify"]
            }
          }
        },
        {
          "name": "Delete Domain",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}/domains/{{domainId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tenants", "{{tenantId}}", "domains", "{{domainId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Resolve",
      "item": [
        {
          "name": "Resolve by Tenant Key",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/resolve?tenantKey={{tenantKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "resolve"],
              "query": [
                {
                  "key": "tenantKey",
                  "value": "{{tenantKey}}"
                }
              ]
            }
          }
        },
        {
          "name": "Resolve by Hostname",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/resolve?hostname={{hostname}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "resolve"],
              "query": [
                {
                  "key": "hostname",
                  "value": "{{hostname}}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
