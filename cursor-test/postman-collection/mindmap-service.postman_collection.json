{
  "info": {
    "name": "mindmap-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8087"
    },
    {
      "key": "tenantId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "mindMapId",
      "value": "22222222-2222-2222-2222-222222222222"
    },
    {
      "key": "nodeId",
      "value": "33333333-3333-3333-3333-333333333333"
    },
    {
      "key": "edgeId",
      "value": "44444444-4444-4444-4444-444444444444"
    },
    {
      "key": "userId",
      "value": "55555555-5555-5555-5555-555555555555"
    }
  ],
  "item": [
    {
      "name": "Mind Maps",
      "item": [
        {
          "name": "Create Mind Map",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Quadratic Equations\",\n  \"subject\": \"Math\",\n  \"grade\": \"10\",\n  \"tags\": [\"algebra\"],\n  \"visibility\": \"TENANT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/mindmaps"
          }
        },
        {
          "name": "Get Mind Map",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/mindmaps/{{mindMapId}}"
          }
        },
        {
          "name": "Get Graph",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/mindmaps/{{mindMapId}}/graph?version=published"
          }
        },
        {
          "name": "Upsert Node",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"CONCEPT\",\n  \"title\": \"Quadratic Formula\",\n  \"posX\": 120,\n  \"posY\": 240\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/mindmaps/{{mindMapId}}/nodes/{{nodeId}}"
          }
        },
        {
          "name": "Delete Node",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/mindmaps/{{mindMapId}}/nodes/{{nodeId}}"
          }
        },
        {
          "name": "Upsert Edge",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromNodeId\": \"{{nodeId}}\",\n  \"toNodeId\": \"{{nodeId}}\",\n  \"relation\": \"EXPLAINS\",\n  \"weight\": 0.5,\n  \"strength\": 0.6,\n  \"ttlSeconds\": 172800\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/mindmaps/{{mindMapId}}/edges/{{edgeId}}"
          }
        },
        {
          "name": "Delete Edge",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/mindmaps/{{mindMapId}}/edges/{{edgeId}}"
          }
        },
        {
          "name": "Publish Mind Map",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"publishTargets\": {\n    \"scope\": \"CLASS\",\n    \"classIds\": [\"class_10A\"]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/mindmaps/{{mindMapId}}/publish"
          }
        },
        {
          "name": "Search Nodes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/mindmaps/{{mindMapId}}/nodes/search?q=quadratic&limit=20"
          }
        },
        {
          "name": "Review Edge",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"result\": \"CORRECT\",\n  \"difficulty\": 2,\n  \"timeSpentSeconds\": 45\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/mindmaps/{{mindMapId}}/edges/{{edgeId}}/review"
          }
        },
        {
          "name": "Get Weak Edges",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/mindmaps/revision/weak?userId={{userId}}&limit=50"
          }
        }
      ]
    }
  ]
}
