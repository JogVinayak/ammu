{
  "info": {
    "name": "graph-relations-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8087"
    },
    {
      "key": "tenantId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "graphId",
      "value": "22222222-2222-2222-2222-222222222222"
    },
    {
      "key": "nodeId",
      "value": "33333333-3333-3333-3333-333333333333"
    },
    {
      "key": "fromNodeId",
      "value": "33333333-3333-3333-3333-333333333333"
    },
    {
      "key": "toNodeId",
      "value": "77777777-7777-7777-7777-777777777777"
    },
    {
      "key": "edgeId",
      "value": "44444444-4444-4444-4444-444444444444"
    },
    {
      "key": "userId",
      "value": "55555555-5555-5555-5555-555555555555"
    },
    {
      "key": "refId",
      "value": "66666666-6666-6666-6666-666666666666"
    }
  ],
  "item": [
    {
      "name": "Graphs",
      "item": [
        {
          "name": "Create Graph",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"scopeType\": \"TENANT\",\n  \"name\": \"Algebra Mind Map\",\n  \"description\": \"Foundational algebra graph\",\n  \"status\": \"DRAFT\",\n  \"createdBy\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/graph-relations/graphs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json && json.id) {",
                  "    pm.collectionVariables.set(\"graphId\", json.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Graph",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}"
          }
        },
        {
          "name": "List Graphs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/graph-relations/graphs?scopeType=TENANT&status=DRAFT"
          }
        },
        {
          "name": "Update Graph",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Algebra Mind Map - Updated\",\n  \"description\": \"Updated description\",\n  \"status\": \"PUBLISHED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}"
          }
        },
        {
          "name": "Delete Graph",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}"
          }
        }
      ]
    },
    {
      "name": "Nodes",
      "item": [
        {
          "name": "Create Node",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"graphId\": \"{{graphId}}\",\n  \"nodeType\": \"CONTENT_REF\",\n  \"refService\": \"content-service\",\n  \"refType\": \"NOTE\",\n  \"refId\": \"{{refId}}\",\n  \"label\": \"Quadratic Formula\",\n  \"meta\": \"{\\\"x\\\":120,\\\"y\\\":240}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}/nodes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json && json.id) {",
                  "    pm.collectionVariables.set(\"nodeId\", json.id);",
                  "    pm.collectionVariables.set(\"fromNodeId\", json.id);",
                  "    pm.collectionVariables.set(\"toNodeId\", json.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Node",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}/nodes/{{nodeId}}"
          }
        },
        {
          "name": "List Nodes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}/nodes?type=CONTENT_REF&refId={{refId}}"
          }
        },
        {
          "name": "Update Node",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Quadratic Formula - Updated\",\n  \"meta\": \"{\\\"x\\\":180,\\\"y\\\":300}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}/nodes/{{nodeId}}"
          }
        },
        {
          "name": "Delete Node",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}/nodes/{{nodeId}}"
          }
        }
      ]
    },
    {
      "name": "Edges",
      "item": [
        {
          "name": "Create Edge",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"graphId\": \"{{graphId}}\",\n  \"fromNodeId\": \"{{fromNodeId}}\",\n  \"toNodeId\": \"{{toNodeId}}\",\n  \"relationType\": \"RELATED_TO\",\n  \"directed\": true,\n  \"strength\": 0.6,\n  \"ttlHours\": 120,\n  \"meta\": \"{\\\"source\\\":\\\"teacher\\\"}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}/edges"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json && json.id) {",
                  "    pm.collectionVariables.set(\"edgeId\", json.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Edges",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}/edges?from={{fromNodeId}}&to={{toNodeId}}&type=RELATED_TO"
          }
        },
        {
          "name": "Update Edge",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"directed\": true,\n  \"strength\": 0.72,\n  \"ttlHours\": 168,\n  \"lastReinforcedAt\": \"2026-01-25T00:00:00Z\",\n  \"lastReviewedAt\": \"2026-01-25T00:00:00Z\",\n  \"meta\": \"{\\\"notes\\\":\\\"reinforced\\\"}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}/edges/{{edgeId}}"
          }
        },
        {
          "name": "Delete Edge",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}/edges/{{edgeId}}"
          }
        }
      ]
    },
    {
      "name": "Graph Queries",
      "item": [
        {
          "name": "Subgraph",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}/subgraph?nodeId={{nodeId}}&depth=2&limit=500"
          }
        },
        {
          "name": "Neighbors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}/neighbors?nodeId={{nodeId}}&depth=1"
          }
        },
        {
          "name": "Paths",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}/paths?fromNodeId={{fromNodeId}}&toNodeId={{toNodeId}}&maxDepth=6"
          }
        },
        {
          "name": "Due Edges",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}/due-edges?userId={{userId}}&asOf=2026-01-25T00:00:00Z&limit=200"
          }
        },
        {
          "name": "Weak Edges",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/graph-relations/graphs/{{graphId}}/weak-edges?threshold=0.35&limit=200"
          }
        }
      ]
    },
    {
      "name": "Signals",
      "item": [
        {
          "name": "Edge Reinforcement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"graphId\": \"{{graphId}}\",\n  \"edgeId\": \"{{edgeId}}\",\n  \"userId\": \"{{userId}}\",\n  \"signalType\": \"RECALL_CORRECT\",\n  \"signalValue\": 1,\n  \"occurredAt\": \"2026-01-25T00:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/graph-relations/signals/edge-reinforcement"
          }
        }
      ]
    }
  ]
}
