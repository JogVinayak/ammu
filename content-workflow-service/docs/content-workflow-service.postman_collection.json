{
  "info": {
    "name": "content-workflow-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for content-workflow-service APIs"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8086"
    },
    {
      "key": "tenantId",
      "value": "t1"
    },
    {
      "key": "userId",
      "value": "33333333-3333-3333-3333-333333333333"
    },
    {
      "key": "accessToken",
      "value": "access-token"
    },
    {
      "key": "contentId",
      "value": "cnt_123"
    },
    {
      "key": "contentVersionId",
      "value": "v_7"
    },
    {
      "key": "workflowId",
      "value": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
    },
    {
      "key": "reviewTaskId",
      "value": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"
    },
    {
      "key": "reviewerUserId1",
      "value": "44444444-4444-4444-4444-444444444444"
    },
    {
      "key": "reviewerUserId2",
      "value": "55555555-5555-5555-5555-555555555555"
    },
    {
      "key": "classId",
      "value": "cccccccc-cccc-cccc-cccc-cccccccccccc"
    },
    {
      "key": "noteId",
      "value": "dddddddd-dddd-dddd-dddd-dddddddddddd"
    },
    {
      "key": "assignmentId",
      "value": "eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee"
    },
    {
      "key": "studentId",
      "value": "ffffffff-ffff-ffff-ffff-ffffffffffff"
    }
  ],
  "item": [
    {
      "name": "Workflow",
      "item": [
        {
          "name": "Create Workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentId\": \"{{contentId}}\",\n  \"contentVersionId\": \"{{contentVersionId}}\",\n  \"titleSnapshot\": \"Quadratic Equations - Notes\",\n  \"publishTargets\": {\n    \"scope\": \"CLASS\",\n    \"classIds\": [\"class_10A\", \"class_10B\"]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/workflow"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json && json.workflowId) {",
                  "    pm.collectionVariables.set(\"workflowId\", json.workflowId);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Workflow",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/workflow/{{workflowId}}"
          }
        },
        {
          "name": "List Workflows",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": "{{baseUrl}}/workflow?contentId={{contentId}}&state=DRAFT&createdBy={{userId}}&page=0&size=20"
          }
        },
        {
          "name": "Submit For Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewerUserIds\": [\"{{reviewerUserId1}}\", \"{{reviewerUserId2}}\"],\n  \"requiredApprovals\": 1,\n  \"note\": \"Please review for accuracy and syllabus alignment.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/workflow/{{workflowId}}/submit"
          }
        },
        {
          "name": "Approve Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Looks good.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/workflow/{{workflowId}}/reviews/{{reviewTaskId}}/approve"
          }
        },
        {
          "name": "Reject Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Needs clearer explanation in example 2.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/workflow/{{workflowId}}/reviews/{{reviewTaskId}}/reject"
          }
        },
        {
          "name": "Publish Workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"publishAt\": null,\n  \"publishTargets\": {\n    \"scope\": \"CLASS\",\n    \"classIds\": [\"class_10A\"]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/workflow/{{workflowId}}/publish"
          }
        },
        {
          "name": "Archive Workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": "{{baseUrl}}/workflow/{{workflowId}}/archive"
          }
        }
      ]
    },
    {
      "name": "Assignments",
      "item": [
        {
          "name": "Create Assignment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"noteId\": \"{{noteId}}\",\n  \"classId\": \"{{classId}}\",\n  \"title\": \"Chapter 1 Review\",\n  \"description\": \"Complete the Chapter 1 review assignment\",\n  \"dueDate\": \"2026-02-15T23:59:59Z\",\n  \"cycleConfig\": {\n    \"intervalDays\": [1, 3, 7, 14, 30],\n    \"autoRemind\": true,\n    \"reminderHoursBefore\": 24\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/assignments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json && json.assignmentId) {",
                  "    pm.collectionVariables.set(\"assignmentId\", json.assignmentId);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Assignments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/assignments?page=0&size=20"
          }
        },
        {
          "name": "List Assignments By Class",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/assignments?classId={{classId}}&page=0&size=20"
          }
        },
        {
          "name": "List Assignments By Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/assignments?status=ACTIVE&page=0&size=20"
          }
        },
        {
          "name": "Get Assignment",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/assignments/{{assignmentId}}"
          }
        },
        {
          "name": "Update Assignment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Assignment Title\",\n  \"dueDate\": \"2026-02-20T23:59:59Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/assignments/{{assignmentId}}"
          }
        },
        {
          "name": "Cancel Assignment",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/assignments/{{assignmentId}}"
          }
        },
        {
          "name": "Get Student Assignments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/assignments/users/{{studentId}}?page=0&size=20"
          }
        },
        {
          "name": "Get Assignment Progress",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/assignments/{{assignmentId}}/progress"
          }
        }
      ]
    }
  ]
}
