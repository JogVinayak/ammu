{
  "info": {
    "name": "content-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "tenantId",
      "value": "t1"
    },
    {
      "key": "userId",
      "value": "33333333-3333-3333-3333-333333333333"
    },
    {
      "key": "role",
      "value": "TEACHER"
    },
    {
      "key": "permissions",
      "value": "CONTENT_READ,CONTENT_WRITE"
    },
    {
      "key": "contentId",
      "value": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
    },
    {
      "key": "topicId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "moduleId",
      "value": "22222222-2222-2222-2222-222222222222"
    },
    {
      "key": "eventId",
      "value": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"
    }
  ],
  "item": [
    {
      "name": "Content",
      "item": [
        {
          "name": "Create Content",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "X-Role",
                "value": "{{role}}"
              },
              {
                "key": "X-Permissions",
                "value": "{{permissions}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"NOTE\",\n  \"title\": \"Kinematics - Basics\",\n  \"description\": \"Intro notes\",\n  \"visibility\": \"TENANT\",\n  \"topicId\": \"{{topicId}}\",\n  \"moduleId\": \"{{moduleId}}\",\n  \"tags\": [\"physics\", \"motion\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/v1/content"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json && json.id) {",
                  "    pm.collectionVariables.set(\"contentId\", json.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Content By Id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "X-Role",
                "value": "{{role}}"
              },
              {
                "key": "X-Permissions",
                "value": "{{permissions}}"
              }
            ],
            "url": "{{baseUrl}}/v1/content/{{contentId}}"
          }
        },
        {
          "name": "List Content",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "X-Role",
                "value": "{{role}}"
              },
              {
                "key": "X-Permissions",
                "value": "{{permissions}}"
              }
            ],
            "url": "{{baseUrl}}/v1/content?type=NOTE&status=DRAFT&topicId={{topicId}}&moduleId={{moduleId}}&q=kinematics&page=0&size=20&sort=updatedAt,desc"
          }
        },
        {
          "name": "Update Content",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "X-Role",
                "value": "{{role}}"
              },
              {
                "key": "X-Permissions",
                "value": "{{permissions}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Kinematics - Updated\",\n  \"description\": \"Updated intro notes\",\n  \"visibility\": \"PRIVATE\",\n  \"tags\": [\"physics\", \"basics\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/v1/content/{{contentId}}"
          }
        },
        {
          "name": "Change Status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "X-Role",
                "value": "{{role}}"
              },
              {
                "key": "X-Permissions",
                "value": "{{permissions}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PUBLISHED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/v1/content/{{contentId}}/status"
          }
        },
        {
          "name": "Version Bump Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "X-Role",
                "value": "{{role}}"
              },
              {
                "key": "X-Permissions",
                "value": "{{permissions}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"DRAFT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/v1/content/{{contentId}}/versions/bump"
          }
        },
        {
          "name": "Version Bump Published",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "X-Role",
                "value": "{{role}}"
              },
              {
                "key": "X-Permissions",
                "value": "{{permissions}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"PUBLISHED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/v1/content/{{contentId}}/versions/bump"
          }
        },
        {
          "name": "Soft Delete",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "X-Role",
                "value": "{{role}}"
              },
              {
                "key": "X-Permissions",
                "value": "{{permissions}}"
              }
            ],
            "url": "{{baseUrl}}/v1/content/{{contentId}}"
          }
        }
      ]
    },
    {
      "name": "Outbox",
      "item": [
        {
          "name": "List Outbox Events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "X-Role",
                "value": "{{role}}"
              },
              {
                "key": "X-Permissions",
                "value": "{{permissions}}"
              }
            ],
            "url": "{{baseUrl}}/v1/outbox?status=PENDING&limit=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (Array.isArray(json) && json.length > 0 && json[0].id) {",
                  "    pm.collectionVariables.set(\"eventId\", json[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark Outbox Published",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "X-Role",
                "value": "{{role}}"
              },
              {
                "key": "X-Permissions",
                "value": "{{permissions}}"
              }
            ],
            "url": "{{baseUrl}}/v1/outbox/{{eventId}}/mark-published"
          }
        }
      ]
    }
  ]
}
